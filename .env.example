# AR3 Cockpit settings for this machine: copy to .env (git-ignored) only if you need overrides.
# ./cockpit.sh creates .env on its first run and appends the generated secrets
# (DJANGO_SECRET_KEY, COCKPIT_DB_PASSWORD, COCKPIT_DB_READER_PASSWORD). Keep those: the database
# volume keeps the password it was created with.
#
# Precedence: process environment > .env > tools/cockpit/backend/defaults.env (every key with
# its meaning). The compose settings of the ROS stacks are a different file: docker/.env.

# --- Access from other machines on the LAN (default: this machine only)
# COCKPIT_BIND=0.0.0.0
# COCKPIT_PORT=8400

# --- AI assistant
# ASSISTANT_PROVIDER=ollama              # ollama | anthropic
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ASSISTANT_CHAT_MODEL=llama3.1:8b
# ASSISTANT_ALLOW_EXTERNAL=1             # required before the anthropic provider is used
# ANTHROPIC_API_KEY=<your key>           # secret: only here, never in defaults.env
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Telemetry capture
# TELEMETRY_RATE_HZ=50
# TELEMETRY_RECORD_SIM=1

# --- Viewer ports (must match docker/compose.yaml)
# FOXGLOVE_PORT=8765
# NOVNC_PORT=6080
# LICHTBLICK_PORT=8080

# --- Real arm (Phase 1). Both show a permanent red banner when set.
# COCKPIT_ALLOW_ARM_WITHOUT_ESTOP=1
# COCKPIT_REAL_SCENARIOS=1
