{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ar3.local/scenario.schema.json",
  "title": "AR3 Cockpit scenario",
  "description": "One MoveIt scenario (docs/specs/spec_cockpit.md §12.1). Poses are in the table frame (centre of the table top, z up), metres and degrees.",
  "type": "object",
  "required": ["id", "name", "modes", "task"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "description": "File name without .yaml"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "version": {"type": "integer", "minimum": 1, "description": "Bumped on every save"},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"}, "uniqueItems": true},
    "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sim_mock", "sim_gazebo", "real"]}},
    "world": {"type": "string", "default": "workcell", "description": "Gazebo world of ar3_gazebo (worlds/<name>.sdf)"},
    "start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "named_pose": {"type": "string"},
        "joints": {"$ref": "#/$defs/joints"},
        "gripper": {"type": "number", "minimum": 0}
      },
      "not": {"required": ["named_pose", "joints"]}
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "obstacles": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "bins": {"type": "array", "items": {"$ref": "#/$defs/bin"}},
        "randomize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "seed": {"type": "integer"},
            "xy_jitter_m": {"type": "number", "minimum": 0, "maximum": 0.2},
            "yaw_jitter_deg": {"type": "number", "minimum": 0, "maximum": 180}
          }
        }
      }
    },
    "perception": {"enum": ["ground_truth", "camera"]},
    "task": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["sequence", "pick_place", "sort"]},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "params": {"type": "object"}
      },
      "if": {"properties": {"type": {"const": "sequence"}}},
      "then": {"required": ["steps"], "properties": {"steps": {"minItems": 1}}}
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pipeline": {"enum": ["ompl", "pilz"]},
        "planner_id": {"type": "string"},
        "velocity_scaling": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "acceleration_scaling": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "planning_time_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all_steps_succeed": {"type": "boolean"},
        "objects_in_bins": {"type": "object", "additionalProperties": {"type": "string"}},
        "max_duration_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "repeat": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "$defs": {
    "joints": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6, "description": "joint_1 … joint_6 [rad]"},
    "object": {
      "type": "object",
      "required": ["id", "shape", "size", "pose"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,40}$"},
        "shape": {"enum": ["box", "cylinder", "sphere", "mesh"]},
        "size": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 1, "maxItems": 3, "description": "box [x y z], cylinder [diameter height], sphere [diameter], mesh [scale]"},
        "mesh": {"type": "string", "description": "mesh file below config/scenarios/meshes/ (shape mesh)"},
        "color": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 4}]},
        "class": {"type": "string"},
        "pose": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"},
            "yaw_deg": {"type": "number"}
          }
        },
        "spawn": {"type": "boolean"}
      }
    },
    "bin": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "pattern": "^bin_[a-z0-9_]+$"},
        "ref": {"type": "string", "description": "config/bins.yaml: the bin of that name (without bin_)"},
        "xyz": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
        "yaw": {"type": "number"},
        "size": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 3, "maxItems": 3},
        "wall": {"type": "number", "exclusiveMinimum": 0}
      },
      "oneOf": [{"required": ["ref"]}, {"required": ["xyz", "size"]}]
    },
    "step": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "move_named": {"type": "string"},
        "move_joints": {"$ref": "#/$defs/joints"},
        "move_pose": {
          "type": "object",
          "required": ["x", "y", "z"],
          "additionalProperties": false,
          "properties": {
            "frame": {"enum": ["table", "world", "base_link"]},
            "x": {"type": "number"}, "y": {"type": "number"}, "z": {"type": "number"},
            "rpy_deg": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
            "planner": {"enum": ["ompl", "pilz_lin", "pilz_ptp"]}
          }
        },
        "gripper": {"oneOf": [{"enum": ["open", "closed"]}, {"type": "number", "minimum": 0}]},
        "wait": {"type": "number", "minimum": 0, "maximum": 600}
      }
    }
  }
}
