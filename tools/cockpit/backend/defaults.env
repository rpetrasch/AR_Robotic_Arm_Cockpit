# AR3 Cockpit defaults (docs/specs/spec_cockpit.md §13). Committed; no secrets here.
# Precedence, highest first: process environment > <repo>/.env > this file.
# cockpit.sh writes the generated secrets (DJANGO_SECRET_KEY, database passwords) to <repo>/.env.
# Keys marked "restart" take effect after ./cockpit.sh is restarted.

# Bind address (restart). 0.0.0.0 opens the cockpit to the LAN (§11.1).
COCKPIT_BIND=127.0.0.1
# Port (restart).
COCKPIT_PORT=8400
# Logs, scenario runs, agent token (restart). ~ is expanded.
COCKPIT_DATA_DIR=~/.ar3cockpit

# PostgreSQL 17 + TimescaleDB + pgvector, compose profile `cockpit` (restart).
COCKPIT_DB_HOST=127.0.0.1
COCKPIT_DB_PORT=5445
COCKPIT_DB_NAME=ar3cockpit
COCKPIT_DB_USER=ar3cockpit
# COCKPIT_DB_PASSWORD and COCKPIT_DB_READER_PASSWORD: generated into .env by cockpit.sh.

# Redis 7 for the Channels layer and the status cache (restart).
REDIS_URL=redis://127.0.0.1:6380/0

# 1: simulate Docker, ROS and devices (CI, e2e tests, a laptop without containers).
COCKPIT_FAKE=0
# Fake host in fake mode: macos | ubuntu | ubuntu-real (REAL with devices).
COCKPIT_FAKE_PLATFORM=macos

# Session cookie only over HTTPS (set 1 behind a TLS reverse proxy).
COCKPIT_SECURE_COOKIES=0

# Data capture (docs/specs/spec_cockpit.md §12a), all restart.
# Stored joint / gripper rate in Hz (a divisor of 100: 10, 20, 25, 50, 100). The live plots
# stay at 10 Hz.
TELEMETRY_RATE_HZ=50
# 1: record SIM sessions by default (REAL always starts recording; REMOTE never does).
TELEMETRY_RECORD_SIM=1
# Retention per hypertable, table=days; tables not listed are kept (0 or off: keep).
TELEMETRY_RETENTION=metrics=30,log_lines=7
# Rolling log buffer: at most this many lines per source (§10.2).
LOG_KEEP_PER_SOURCE=50000
# Parquet / CSV exports (relative paths are below the repo).
COCKPIT_EXPORT_DIR=data/exports
# Agent port (the stacks publish it on 127.0.0.1).
AGENT_PORT=8790

# Ports of the viewers the header links to.
FOXGLOVE_PORT=8765
NOVNC_PORT=6080
LICHTBLICK_PORT=8080

# Escape hatches and later-phase switches (C3, C5); listed so every key is documented.
COCKPIT_ALLOW_ARM_WITHOUT_ESTOP=0
COCKPIT_REAL_SCENARIOS=0

# The assistant (docs/specs/spec_cockpit.md §14). Settings → AI overrides the provider and the
# models per task; a value set in .env or the environment wins over the UI.
# ollama | anthropic
ASSISTANT_PROVIDER=ollama
# 1 allows the Anthropic API (questions and their context leave this machine). Without it, or
# without ANTHROPIC_API_KEY (secret, .env only), the assistant answers with Ollama.
ASSISTANT_ALLOW_EXTERNAL=0
ANTHROPIC_MODEL=claude-sonnet-5-5
# Local Ollama, the default chat model and the embedding model of the knowledge index (a new
# embedding model re-indexes everything).
OLLAMA_BASE_URL=http://127.0.0.1:11434
ASSISTANT_CHAT_MODEL=llama3.1:8b
ASSISTANT_EMBED_MODEL=bge-m3
# Questions per user and minute.
ASSISTANT_RATE_PER_MINUTE=20
# Days an untouched assistant thread is kept (restart).
AI_LOG_DAYS=180
# Paths (prefixes or globs) the knowledge index leaves out: the owner's notes, and the AR4
# driver, whose hardware facts are not the AR3's.
ASSISTANT_INDEX_EXCLUDE=docs/notes/,src/external/
# 1: the scripted assistant; 0: the real providers even in fake mode. Empty: follows
# COCKPIT_FAKE.
ASSISTANT_FAKE=
