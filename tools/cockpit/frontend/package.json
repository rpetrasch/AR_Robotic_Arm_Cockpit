{
  "name": "ar3-cockpit-ui",
  "version": "0.1.0",
  "private": true,
  "description": "AR3 Cockpit frontend: Next.js static export served by the Django backend (docs/specs/spec_cockpit.md)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/brand.mjs && next build",
    "gen:api": "cd ../backend && uv run python manage.py spectacular --file ../frontend/lib/api/openapi.yaml && cd ../frontend && openapi-typescript lib/api/openapi.yaml -o lib/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "test:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/lint": "6.9.7",
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "2.8.10",
    "@heroui/theme": "2.4.26",
    "@react-three/fiber": "9.3.0",
    "@tanstack/react-query": "5.101.4",
    "@uiw/react-codemirror": "4.25.12",
    "anser": "2.3.5",
    "bootstrap-icons": "1.13.1",
    "framer-motion": "13.1.0",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-virtuoso": "4.18.20",
    "three": "0.180.0",
    "uplot": "1.6.32",
    "urdf-loader": "0.12.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "openapi-typescript": "7.9.1",
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
