# Copy to docker/.env (not committed) and adjust. Read by docker/compose.yaml.

# Middleware: rmw_fastrtps_cpp (default, single host) or rmw_zenoh_cpp
# (Mac <-> Workstation A; Workstation A then runs the zenohd service).
ROS_RMW=rmw_fastrtps_cpp

# Workstation A's address as seen from the Mac, and the zenohd port.
ZENOH_ROUTER=192.168.1.10
ZENOH_PORT=7447

ROS_DOMAIN_ID=0
